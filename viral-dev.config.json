{
  "localBrain": {
    "provider": "ollama",
    "baseUrl": "http://127.0.0.1:11434",
    "preferredModel": "qwen3:4b-instruct",
    "defaultTimeoutMs": 120000
  },
  "verificationCommands": [
    {
      "name": "typecheck",
      "command": "pnpm run typecheck"
    },
    {
      "name": "tests",
      "command": "pnpm run test"
    },
    {
      "name": "lint",
      "command": "pnpm run lint"
    },
    {
      "name": "m02-acceptance",
      "command": "pnpm run acceptance:m02"
    },
    {
      "name": "m03-acceptance",
      "command": "pnpm run acceptance:m03"
    },
    {
      "name": "m04-acceptance",
      "command": "pnpm run acceptance:m04"
    }
  ],
  "voice": {
    "sampleRateHz": 16000,
    "channels": 1,
    "silenceTimeoutMs": 2000,
    "stt": {
      "executable": "whisper",
      "args": [],
      "modelPath": null
    },
    "tts": {
      "executable": "piper",
      "args": [],
      "modelPath": null
    },
    "audio": {
      "captureCommand": "sox",
      "captureArgs": ["-d", "-q", "-t", "raw", "-r", "16000", "-e", "signed-integer", "-b", "16", "-c", "1", "-"],
      "playbackCommand": "sox",
      "playbackArgs": ["-q", "-t", "raw", "-r", "16000", "-e", "signed-integer", "-b", "16", "-c", "1", "-", "-d"],
      "speechThreshold": 500
    }
  },
  "efficiencyGovernor": {
    "primaryHarness": "claude",
    "allowAutomaticPaidHarnessSwitch": false,
    "maximumAttempts": 6,
    "failuresPerEffortLevel": 2,
    "initialContextCharacters": 12000,
    "maximumContextCharacters": 24000,
    "freshSessionCharacters": 18000,
    "freshSessionCompletedRatio": 0.6,
    "freshSessionNoiseRatio": 0.5,
    "maximumTelemetryEvents": 500
  }
}
