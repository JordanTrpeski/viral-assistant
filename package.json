{
  "name": "viral-development-controller",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "viral-dev": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "viral-dev": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "acceptance:m02": "pnpm run build && node --test dist/tests/local-model.test.js dist/tests/local-tasks.test.js",
    "acceptance:m03": "pnpm run build && node --test dist/tests/runtime.test.js dist/tests/runtime-service.test.js",
    "acceptance:m04": "pnpm run build && node --test dist/tests/efficiency*.test.js",
    "acceptance:m06": "pnpm run build && node --test dist/tests/desktop-*.test.js",
    "lint": "node scripts/lint.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "ws": "^8.21.3"
  }
}
