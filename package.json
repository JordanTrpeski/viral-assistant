{
  "name": "jarvis-development-controller",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "jarvis-dev": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "jarvis-dev": "node dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "acceptance:m02": "pnpm run build && node --test dist/tests/local-model.test.js dist/tests/local-tasks.test.js",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
